olumn":1}},"key":"L53rVC6hiM"},{"type":"inlineCode","value":"BrokerConfig","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"ui5nXUZ6MZ"},{"type":"text","value":" (where the HELICS broker is) and starts the\nfederate as a background task.","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"vPqRPUkaNZ"}],"key":"S6b3yFVLt6"}],"key":"QpFnabesOc"}],"key":"PcUZ9CtMM9"},{"type":"heading","depth":2,"position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"text","value":"3. Do the work — the HELICS federate","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"b8KolRjWsn"}],"identifier":"id-3-do-the-work-the-helics-federate","label":"3. Do the work — the HELICS federate","html_id":"id-3-do-the-work-the-helics-federate","implicit":true,"key":"knTyfKWRdW"},{"type":"paragraph","position":{"start":{"line":123,"column":1},"end":{"line":125,"column":1}},"children":[{"type":"text","value":"The federate creates a value federate, registers its subscriptions and publications from\n","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"key":"esaGo3OrmL"},{"type":"inlineCode","value":"input_mapping.json","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"key":"jqUWqa9V2p"},{"type":"text","value":", then advances through time. This mirrors\n","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"key":"ZHpg3OnxcH"},{"type":"link","url":"https://github.com/openEDI/oedisi-components/blob/main/Components/measuring_federate/src/measuring_federate/measuring_federate.py","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"children":[{"type":"inlineCode","value":"measuring_federate.py","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"key":"Kx7xQBW5jY"}],"urlSource":"https://github.com/openEDI/oedisi-components/blob/main/Components/measuring_federate/src/measuring_federate/measuring_federate.py","data":{"kind":"file","org":"openEDI","repo":"oedisi-components","reference":"main","file":"Components/measuring_federate/src/measuring_federate/measuring_federate.py","raw":"https://raw.githubusercontent.com/openEDI/oedisi-components/main/Components/measuring_federate/src/measuring_federate/measuring_federate.py"},"internal":false,"protocol":"github","key":"FM5t7UnNml"},{"type":"text","value":":","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"key":"mZWli0fZRh"}],"key":"jKvPbA1in2"},{"type":"code","lang":"python","value":"import helics as h\nfrom oedisi.types.common import BrokerConfig\nfrom oedisi.types.data_types import MeasurementArray\n\ndef run_simulator(broker_config: BrokerConfig):\n    # 1. Describe and connect the federate to the broker.\n    fedinfo = h.helicsCreateFederateInfo()\n    fedinfo.core_name = \"my_component\"\n    fedinfo.core_type = h.HELICS_CORE_TYPE_ZMQ\n    fedinfo.core_init = \"--federates=1\"\n    h.helicsFederateInfoSetBroker(fedinfo, broker_config.broker_ip)\n    h.helicsFederateInfoSetBrokerPort(fedinfo, broker_config.broker_port)\n    vfed = h.helicsCreateValueFederate(\"my_component\", fedinfo)\n\n    # 2. Register I/O. Subscriptions come from input_mapping.json.\n    import json\n    input_mapping = json.load(open(\"input_mapping.json\"))\n    sub = vfed.register_subscription(input_mapping[\"subscription\"], \"\")\n    pub = vfed.register_publication(\"publication\", h.HELICS_DATA_TYPE_STRING, \"\")\n\n    # 3. Step through time until the simulation ends.\n    vfed.enter_executing_mode()\n    granted_time = h.helicsFederateRequestTime(vfed, h.HELICS_TIME_MAXTIME)\n    while granted_time < h.HELICS_TIME_MAXTIME:\n        measurement = MeasurementArray.model_validate(sub.json)   # read typed input\n        # ... transform measurement ...\n        pub.publish(measurement.model_dump_json())                # publish typed output\n        granted_time = h.helicsFederateRequestTime(vfed, h.HELICS_TIME_MAXTIME)\n\n    vfed.disconnect()","position":{"start":{"line":127,"column":1},"end":{"line":158,"column":1}},"key":"G1bpmCx3pL"},{"type":"paragraph","position":{"start":{"line":160,"column":1},"end":{"line":160,"column":1}},"children":[{"type":"text","value":"The key ideas:","position":{"start":{"line":160,"column":1},"end":{"line":160,"column":1}},"key":"rJ5Y9ADft9"}],"key":"aN6diMmZH7"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":162,"column":1},"end":{"line":167,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":162,"column":1},"end":{"line":163,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Subscriptions are keyed by ","position":{"start":{"line":162,"column":1},"end":{"line":162,"column":1}},"key":"n1X7pOlN8L"},{"type":"inlineCode","value":"input_mapping.json","position":{"start":{"line":162,"column":1},"end":{"line":162,"column":1}},"key":"fDJ0L5LJZ0"},{"type":"text","value":", which ","position":{"start":{"line":162,"column":1},"end":{"line":162,"column":1}},"key":"VaWwwrcJy0"},{"type":"inlineCode","value":"/configure","position":{"start":{"line":162,"column":1},"end":{"line":162,"column":1}},"key":"pN71BtBNmD"},{"type":"text","value":" wrote from the\nwiring diagram’s links.","position":{"start":{"line":162,"column":1},"end":{"line":162,"column":1}},"key":"wHMlVKZ806"}],"key":"Cn7WRJB6vA"}],"key":"u4Hn9LA4Ov"},{"type":"listItem","spread":true,"position":{"start":{"line":164,"column":1},"end":{"line":165,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Values are exchanged as JSON-serialized ","position":{"start":{"line":164,"column":1},"end":{"line":164,"column":1}},"key":"lVia9OmETz"},{"type":"link","url":"/reference/data-types","position":{"start":{"line":164,"column":1},"end":{"line":164,"column":1}},"children":[{"type":"text","value":"OEDI-SI data types","position":{"start":{"line":164,